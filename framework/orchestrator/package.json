{
  "name": "specloop-loop",
  "version": "0.1.0",
  "description": "CLI-agnostic loop orchestrator generated by specloop into a scaffolded repo. Reads planning/roadmap.md and works through each spec's tasks.md.",
  "type": "commonjs",
  "bin": {
    "loop": "./bin/loop.cjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src bin eslint.config.cjs",
    "format:check": "prettier --check src bin eslint.config.cjs"
  },
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.69.0"
  }
}
